# LiveKit Cloud connection.
# Required for local dev and deployment.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicit dispatch name used by Voxa when dispatching Nova.
LIVEKIT_AGENT_NAME=nova

# Gemini Live realtime voice model.
GOOGLE_API_KEY=
NOVA_GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
NOVA_GEMINI_VOICE=Kore
NOVA_GEMINI_TEMPERATURE=0.8
NOVA_ENABLE_GOOGLE_SEARCH=true
NOVA_WAKE_WORD=Nova
