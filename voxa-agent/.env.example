# LiveKit Cloud connection.
# Required for local dev and deployment.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicit dispatch name used by Voxa when dispatching Nova.
LIVEKIT_AGENT_NAME=nova

# Future voice intelligence providers.
# Not required for the current presence-only Nova agent.
OPENAI_API_KEY=
