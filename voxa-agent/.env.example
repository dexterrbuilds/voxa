# LiveKit Cloud connection.
# Required for local dev and deployment.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicit dispatch name used by Voxa when dispatching Nova.
LIVEKIT_AGENT_NAME=nova

# Future voice intelligence providers.
OPENAI_API_KEY=

# Nova voice pipeline defaults.
NOVA_STT_MODEL=gpt-4o-mini-transcribe
NOVA_LLM_MODEL=gpt-4.1-mini
NOVA_TTS_MODEL=gpt-4o-mini-tts
NOVA_TTS_VOICE=shimmer
NOVA_TTS_SPEED=1.15
