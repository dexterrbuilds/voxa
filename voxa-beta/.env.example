NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side LiveKit credentials. Never prefix the key or secret with NEXT_PUBLIC.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

NEXT_PUBLIC_NOVA_LISTEN_WINDOW_MS=10000
# Silence-based Nova capture tuning (browser-side).
# Stop capturing after this much sustained silence once the user has spoken.
NEXT_PUBLIC_NOVA_SILENCE_TIMEOUT_MS=2000
# Hard cap on a single capture so the recorder can never run forever.
NEXT_PUBLIC_NOVA_MAX_RECORDING_MS=15000
# RMS amplitude (0..1) below which a frame is treated as silence.
NEXT_PUBLIC_NOVA_SILENCE_THRESHOLD=0.015
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NOVA_TTS_PROVIDER=edge
NOVA_TTS_VOICE=shimmer
NOVA_TTS_SPEED=1.15
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# --- Wake-word activation (Picovoice Porcupine Web) ---
# Picovoice runs ENTIRELY in the browser, so its AccessKey must be public.
# This is NOT a backend secret. Never put Deepgram/Gemini/OpenAI/Supabase
# service-role/LiveKit secrets behind NEXT_PUBLIC_.
# Get a free AccessKey at https://console.picovoice.ai
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
# Display label for the wake word.
NEXT_PUBLIC_NOVA_WAKE_WORD=Hey Nova
# Public path to a CUSTOM "Nova" Porcupine keyword (.ppn) built for the
# Web (WASM) platform in the Picovoice Console. Leave empty to temporarily
# fall back to a built-in keyword. Recommended location: public/picovoice/nova.ppn
NEXT_PUBLIC_NOVA_WAKE_WORD_MODEL_PATH=/picovoice/hey_nova.ppn
NEXT_PUBLIC_PICOVOICE_MODEL_PATH=/picovoice/porcupine_params.pv

# Server-side Nova pipeline credentials.
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NOVA_TTS_PROVIDER=edge
NOVA_TTS_VOICE=en-US-JennyNeural
NOVA_TTS_SPEED=1.15
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
